{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FUORISEDE Listing V2",
  "type": "object",
  "required": ["id", "title", "city", "publication", "availability", "validation"],
  "properties": {
    "id": {"type": ["integer", "string"]},
    "title": {"type": "string"},
    "city": {"type": "string"},
    "address": {"type": ["string", "null"]},
    "lat": {"type": ["number", "null"]},
    "lng": {"type": ["number", "null"]},
    "price": {"type": ["number", "null"], "minimum": 0},
    "expenses": {"type": ["number", "null"], "minimum": 0},
    "realMonthlyCost": {"type": ["number", "null"], "minimum": 0},
    "realMonthlyCostStatus": {"enum": ["complete", "minimum_known", "unknown"]},
    "availability": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "availableFrom": {"type": ["string", "null"], "format": "date"},
        "availableLabel": {"type": ["string", "null"]},
        "status": {"enum": ["confirmed", "to_reconfirm", "unavailable", "unknown"]},
        "confirmedAt": {"type": ["string", "null"], "format": "date"},
        "nextCheckAt": {"type": ["string", "null"], "format": "date"}
      }
    },
    "publication": {
      "type": "object",
      "required": ["authorized"],
      "properties": {
        "authorized": {"type": "boolean"},
        "authorizationSource": {"type": ["string", "null"]},
        "authorizedAt": {"type": ["string", "null"], "format": "date"},
        "source": {"type": ["string", "null"]},
        "sourceUrl": {"type": ["string", "null"]}
      }
    },
    "validation": {
      "type": "object",
      "required": ["contactProvided", "priceDeclared", "expensesDeclared", "contractDeclared", "depositDeclared", "utilitiesDeclared"],
      "properties": {
        "contactProvided": {"type": "boolean"},
        "priceDeclared": {"type": "boolean"},
        "expensesDeclared": {"type": "boolean"},
        "contractDeclared": {"type": "boolean"},
        "depositDeclared": {"type": "boolean"},
        "utilitiesDeclared": {"type": "boolean"},
        "listingConfirmedAt": {"type": ["string", "null"], "format": "date"}
      }
    },
    "campusReference": {
      "type": ["object", "null"],
      "description": "Reference point only: never a hard geographic inclusion boundary.",
      "properties": {
        "campusId": {"type": ["string", "null"]},
        "campusName": {"type": ["string", "null"]},
        "distanceKm": {"type": ["number", "null"], "minimum": 0},
        "minutesWalk": {"type": ["integer", "null"], "minimum": 0},
        "minutesBike": {"type": ["integer", "null"], "minimum": 0},
        "minutesTransit": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "contactWorkflow": {
      "type": ["object", "null"],
      "properties": {
        "providerName": {"type": ["string", "null"]},
        "email": {"type": ["string", "null"]},
        "emailThreadRef": {"type": ["string", "null"]},
        "nextReconfirmationAt": {"type": ["string", "null"], "format": "date"}
      }
    }
  }
}
